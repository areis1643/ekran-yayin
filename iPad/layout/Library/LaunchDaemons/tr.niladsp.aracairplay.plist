<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>tr.niladsp.aracairplay</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/libexec/aracairplay</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Library/Logs/arac-airplay.err</string>
    <!-- root başlar: iOS 9 burada JetsamProperties'i yok sayıyor (5 MB, öncelik 0 ölçüldü);
         daemon jetsam sınırını kendisi koyup mobile kullanıcısına iner (aracairplay.c drop_root). -->
</dict>
</plist>
